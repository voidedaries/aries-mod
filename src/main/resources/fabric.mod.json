{
  "schemaVersion": 1,
  "id": "aries",
  "version": "${version}",
  "name": "Aries",
  "description": "A modern client-side Quality of Life mod for Hypixel SkyBlock.",
  "authors": [
    "VoidedAries"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/aries",
    "sources": "https://github.com/voidedaries/aries-mod",
    "issues": "https://github.com/voidedaries/aries-mod/issues"
  },
  "license": "GPL-3.0",
  "icon": "assets/aries/logo_icon.png",
  "environment": "client",
  "entrypoints": {
    "fabric-datagen": [
      "dev.voidedaries.aries.client.AriesDataGenerator"
    ],
    "client": [
      "dev.voidedaries.aries.client.AriesClient"
    ],
    "main": [
      "dev.voidedaries.aries.Aries"
    ],
    "modmenu": [
      "dev.voidedaries.aries.client.compatibility.AriesModMenuApi"
    ]
  },
  "mixins": [
    "aries.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "https://discord.gg/E5DYwuKPK3",
        "modmenu.modrinth": "https://modrinth.com/mod/aries"
      }
    }
  },
  "accessWidener": "aries.aw"
}
